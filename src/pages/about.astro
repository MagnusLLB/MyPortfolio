---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Your Name">
	<section class="hero">
		<h1>About Me</h1>
		<p>
			Replace this with a short bio: what you study, what you're interested in, and what kind
			of work or opportunities you're looking for.
		</p>
	</section>

	<section>
		<h2 class="section-title">Get in touch</h2>
		<p>
			<a href="mailto:you@example.com">you@example.com</a> &middot;
			<a href="https://github.com/yourhandle" target="_blank" rel="noreferrer">GitHub</a> &middot;
			<a href="https://linkedin.com/in/yourhandle" target="_blank" rel="noreferrer">LinkedIn</a>
		</p>
	</section>
</BaseLayout>
